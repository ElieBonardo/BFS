
<!DOCTYPE html>.
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Récupérer mon mot de passe - BFS</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      padding: 25px;
    }
    .box {
      max-width: 420px;
      margin: 50px auto;
      background: white;
      padding: 25px;
      border-radius: 12px;
    }
    input, button {
      width: 100%;
      box-sizing: border-box;
      padding: 13px;
      margin-top: 15px;
      font-size: 16px;
    }
    button {
      background: #111;
      color: white;
      border: 0;
      border-radius: 7px;
    }
    #message { overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <div class="box">
    <h2>Bonardo Fashion Store BFS</h2>
    <p>Entre ton adresse e-mail pour recevoir un lien de récupération.</p>

    <form id="recoveryForm">
      <input id="email" type="email"
        placeholder="Adresse e-mail" required>
      <button type="submit">Envoyer le lien</button>
    </form>

    <p id="message"></p>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const supabaseClient = window.supabase.createClient(
      "https://eulbdrwxyhdvosbmxnwy.supabase.co",
      "sb_publishable_LfwW5XWa2C_3WPArJvEsbQ_Klth7gNl"
    );

    document.getElementById("recoveryForm")
      .addEventListener("submit", async function(event) {
        event.preventDefault();

        const message = document.getElementById("message");
        const email = document.getElementById("email").value.trim();

        message.textContent = "Envoi en cours...";

        const { error } = await supabaseClient.auth
          .resetPasswordForEmail(email, {
            redirectTo:
              "https://eliebonardo.github.io/BFS/set-password.html"
          });

        if (error) {
          message.textContent = "Erreur : " + error.message;
          return;
        }

        message.textContent =
          "Demande envoyée. Vérifie ta boîte e-mail et les courriers indésirables.";
      });
  </script>
</body>
</html>
